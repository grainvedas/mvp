{
  "name": "grainveda-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode staging",
    "build:ci": "tsc -b && vite build --mode staging",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:production": "tsc -b && vite build --mode production",
    "serve:dist": "node scripts/serve-dist.mjs",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "e2e:acceptance": "playwright test -c playwright.acceptance.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^5.8.8",
    "write-excel-file": "^2.3.10"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
